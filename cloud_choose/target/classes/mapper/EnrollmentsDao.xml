<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lyw.cloudChoose.mapper.EnrollmentsDao">


    <select id="selectEnrolledCourseIds" resultType="java.lang.Long">
        select course_id
        from enrollments
        where student_id=#{studentId} and status in ('PENDING','SUCCESS','WAITING')
    </select>
</mapper>
