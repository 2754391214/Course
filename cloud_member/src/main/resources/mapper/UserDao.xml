<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lyw.cloudMember.mapper.UserDao">

    <resultMap id="UserMap" type="com.lyw.cloudMember.vo.UserVo">
        <!-- 用户基本信息 -->
        <id column="id" property="id"/>
        <result column="username" property="userName"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="gender" property="gender"/>
        <result column="birthday" property="birthday"/>
        <result column="bio" property="bio"/>
        <result column="user_type" property="userType"/>
        <result column="status" property="status"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="last_login_ip" property="lastLoginIp"/>
        <result column="cru" property="cru"/>
        <result column="crd" property="crd"/>
        <result column="luu" property="luu"/>
        <result column="lud" property="lud"/>

        <!-- 学生信息 -->
        <association property="studentProfile"
                     javaType="com.lyw.cloudMember.vo.StudentProfileVo"
                     columnPrefix="s_">
            <id column="id" property="id"/>
            <result column="user_id" property="userId"/>
            <result column="student_id" property="studentId"/>
            <result column="grade" property="grade"/>
            <result column="major" property="major"/>
            <result column="faculty" property="faculty"/>
            <result column="enrollment_year" property="enrollmentYear"/>
            <result column="expected_graduation" property="expectedGraduation"/>
            <result column="gpa" property="gpa"/>
            <result column="credits_earned" property="creditsEarned"/>
            <result column="academic_status" property="academicStatus"/>
        </association>

        <!-- 教师信息 -->
        <association property="teacherProfile"
                     javaType="com.lyw.cloudMember.vo.TeacherProfileVo"
                     columnPrefix="t_">
            <id column="id" property="id"/>
            <result column="user_id" property="userId"/>
            <result column="teacher_id" property="teacherId"/>
            <result column="title" property="title"/>
            <result column="department" property="department"/>
            <result column="office" property="office"/>
            <result column="research_field" property="researchField"/>
            <result column="teaching_years" property="teachingYears"/>
            <result column="is_tutor" property="isTutor"/>
            <result column="employment_status" property="employmentStatus"/>
        </association>
    </resultMap>

    <select id="selectInfoById" resultMap="UserMap">
        SELECT
            u.*,
            t.id as t_id,
            t.user_id as t_user_id,
            t.teacher_id as t_teacher_id,
            t.title as t_title,
            t.department as t_department,
            t.office as t_office,
            t.research_field as t_research_field,
            t.teaching_years as t_teaching_years,
            t.is_tutor as t_is_tutor,
            t.employment_status as t_employment_status,
            s.id as s_id,
            s.user_id as s_user_id,
            s.student_id as s_student_id,
            s.grade as s_grade,
            s.major as s_major,
            s.faculty as s_faculty,
            s.enrollment_year as s_enrollment_year,
            s.expected_graduation as s_expected_graduation,
            s.gpa as s_gpa,
            s.credits_earned as s_credits_earned,
            s.academic_status as s_academic_status
        FROM user u
                 LEFT JOIN teacher_profile t ON u.id = t.user_id
                 LEFT JOIN student_profile s ON u.id = s.user_id
        WHERE u.id = #{userId};
    </select>
</mapper>
